{
  "name": "tc-pi",
  "version": "0.9.2",
  "packageManager": "npm@11.6.2",
  "engines": {
    "npm": "^11.6.2"
  },
  "description": "TC-Pi is an open-source desktop workbench to manage multiple pi AI coding agents across local project folders with session history, Git integration, terminal, and config management.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "ayuayue",
    "email": "ayuayue@users.noreply.github.com"
  },
  "contributors": [
    {
      "name": "1900EasonJin",
      "url": "https://github.com/1900EasonJin"
    }
  ],
  "homepage": "https://github.com/T-Chen-CN/TC-Pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-Chen-CN/TC-Pi.git"
  },
  "bugs": {
    "url": "https://github.com/T-Chen-CN/TC-Pi/issues"
  },
  "keywords": [
    "pi",
    "pi-agent",
    "ai-coding-agent",
    "coding-agent",
    "electron",
    "electron-app",
    "desktop",
    "desktop-app",
    "rpc",
    "agent",
    "ai-assistant",
    "local-ai",
    "developer-tools",
    "productivity",
    "workspace",
    "session-management",
    "git",
    "terminal",
    "monaco-editor",
    "claude-code",
    "codex",
    "multi-project",
    "typescript",
    "windows",
    "macos",
    "linux",
    "open-source"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run generate:pi-ai-catalog && npm run generate:extensions-manifest && npm run generate:prompts-manifest && npm run generate:skills-manifest && tsc --noEmit --skipLibCheck --incremental && electron-vite build",
    "build:fast": "npm run generate:pi-ai-catalog && npm run generate:extensions-manifest && npm run generate:prompts-manifest && npm run generate:skills-manifest && electron-vite build",
    "build:main": "electron-vite build --config electron.vite.main.mjs",
    "generate:pi-ai-catalog": "node scripts/generate-pi-ai-catalog.mjs",
    "check:pi-ai-catalog": "node scripts/generate-pi-ai-catalog.mjs --check",
    "generate:extensions-manifest": "node scripts/generate-extensions-manifest.mjs",
    "check:extensions-manifest": "node scripts/generate-extensions-manifest.mjs --check",
    "generate:prompts-manifest": "node scripts/generate-content-manifests.mjs --domain prompts",
    "check:prompts-manifest": "node scripts/generate-content-manifests.mjs --domain prompts --check",
    "generate:skills-manifest": "node scripts/generate-content-manifests.mjs --domain skills",
    "check:skills-manifest": "node scripts/generate-content-manifests.mjs --domain skills --check",
    "check:electron": "node scripts/check-electron.mjs",
    "pack:dev": "node scripts/pack-dev.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "node scripts/dist-win.js",
    "dist:win:dev": "node scripts/dist-dev.js --win nsis portable zip",
    "dist:mac:dev": "node scripts/dist-dev.js --mac dmg zip",
    "dist:linux:dev": "node scripts/dist-dev.js --linux AppImage deb tar.gz --x64",
    "dist:linux:dev:arm64": "node scripts/dist-dev.js --linux AppImage deb tar.gz --arm64",
    "dist:fast": "node scripts/dist-fast.js",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb tar.gz",
    "dist:linux:arm64": "npm run build && electron-builder --linux AppImage deb tar.gz --arm64",
    "preview": "electron-vite preview",
    "test": "node --test --test-force-exit --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:serial": "node --test --test-force-exit --test-concurrency=1 \"tests/*.test.mjs\"",
    "format": "biome format --write src tests scripts e2e",
    "check:format": "biome format src tests scripts e2e",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "sync:main": "node scripts/sync-main.mjs",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/release-preflight.mjs",
    "make-icon": "node scripts/make-icon.js",
    "compile-exe": "node scripts/compile-exe.js",
    "test:e2e": "npm run build:fast && playwright test",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9",
    "ignore": "^5.3.2",
    "minimatch": "^10.2.5",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.8.0",
    "sql.js": "^1.14.1",
    "tar": "^7.5.15"
  },
  "build": {
    "appId": "com.ayuayue.pi-desktop",
    "productName": "TC-Pi",
    "protocols": [
      {
        "name": "TC-Pi Agent Link",
        "schemes": [
          "pideck"
        ]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "afterPack": "./scripts/after-pack-cleanup.js",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm",
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon",
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/sql.js/dist/*-asm*",
      "!node_modules/sql.js/dist/*-debug*",
      "!node_modules/sql.js/dist/*browser*",
      "!node_modules/sql.js/dist/worker*"
    ],
    "extraResources": [
      {
        "from": "resources/extensions",
        "to": "extensions",
        "filter": [
          "*.ts",
          "extensions-manifest.json"
        ]
      },
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/prompts",
        "to": "prompts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/plugin-dev",
        "to": "plugin-dev",
        "filter": [
          "*.ts"
        ]
      },
      {
        "from": "resources/quick-messages.default.json",
        "to": "quick-messages.default.json"
      },
      {
        "from": "resources/reply-actions.default.json",
        "to": "reply-actions.default.json"
      },
      {
        "from": "resources/pi-auth-host.mjs",
        "to": "pi-auth-host.mjs"
      },
      {
        "from": "resources/pi-auth-migration.mjs",
        "to": "pi-auth-migration.mjs"
      },
      {
        "from": "resources/pi-enhance-host.mjs",
        "to": "pi-enhance-host.mjs"
      },
      {
        "from": "resources/pi-ai-catalog.json",
        "to": "pi-ai-catalog.json"
      },
      {
        "from": "resources/pi-ai-catalog.manifest.json",
        "to": "pi-ai-catalog.manifest.json"
      }
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "artifactName": "${productName}-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/install-directory-storage.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "ayuayue <ayuayue@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "T-Chen-CN",
      "repo": "TC-Pi"
    }
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.51",
    "@biomejs/biome": "2.3.11",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-ai": "1.0.4",
    "@fiahfy/icns": "^0.0.7",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "^1.3.5",
    "@playwright/test": "^1.62.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.48",
    "app-builder-bin": "^5.0.0-alpha.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^10.6.0",
    "html-to-image": "^1.11.13",
    "jotai": "^2.20.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "motion": "^13.0.0",
    "opencc-js": "^1.4.2",
    "png-to-ico": "^3.0.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remove-markdown": "^0.6.4",
    "sharp": "^0.34.5",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.5",
    "vitepress": "^1.6.4"
  }
}
